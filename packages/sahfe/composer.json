{
    "name": "benh/sahfe",
    "type": "typo3-cms-extension",
    "description": "sahfe - Frontend Sitepackage Extension",
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "./packages/*"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.4"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "sahfe"
        }
    }
}