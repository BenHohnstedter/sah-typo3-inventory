mod.wizards.newContentElement.wizardItems {
  sahiv {
    after = plugins
    header = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv
    show = *
    elements {
      sahiv_color {
        iconIdentifier = sahiv-plugin-color
        title = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_color.title
        description = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_color.description
        tt_content_defValues {
          CType = list
          list_type = sahiv_colorplugin
        }
      }
      sahiv_colortone {
        iconIdentifier = sahiv-plugin-colortone
        title = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_colortone.title
        description = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_colortone.description
        tt_content_defValues {
          CType = list
          list_type = sahiv_colortoneplugin
        }
      }
      sahiv_material {
        iconIdentifier = sahiv-plugin-material
        title = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_material.title
        description = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_material.description
        tt_content_defValues {
          CType = list
          list_type = sahiv_materialplugin
        }
      }
      sahiv_order {
        iconIdentifier = sahiv-plugin-order
        title = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_order.title
        description = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_order.description
        tt_content_defValues {
          CType = list
          list_type = sahiv_orderplugin
        }
      }
      sahiv_product {
        iconIdentifier = sahiv-plugin-product
        title = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_product.title
        description = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_product.description
        tt_content_defValues {
          CType = list
          list_type = sahiv_productplugin
        }
      }
      sahiv_type {
        iconIdentifier = sahiv-plugin-type
        title = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_type.title
        description = LLL:EXT:sahiv/Resources/Private/Language/locallang_be.xlf:plugin.sahiv_type.description
        tt_content_defValues {
          CType = list
          list_type = sahiv_typeplugin
        }
      }
    }
  }
}
